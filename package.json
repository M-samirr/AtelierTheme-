{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier - an editorial Salla React theme for fashion and beauty stores",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:manifest": "twilight-check-manifest",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm check:manifest --strict && pnpm lint && pnpm typecheck && pnpm test && pnpm check:size",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@salla.sa/twilight-components-react": "3.0.40",
    "@salla.sa/twilight-theme-engine": "1.0.160",
    "@tanstack/react-query": "~5.102.8",
    "@tanstack/react-router": "~1.170.38",
    "@tanstack/react-router-devtools": "~1.167.2",
    "@tanstack/react-start": "~1.168.57",
    "@tanstack/virtual-file-routes": "~1.162.0",
    "@uidotdev/usehooks": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@salla.sa/twilight-tailwind-theme": "3.0.40",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query-devtools": "~5.102.8",
    "@tanstack/router-plugin": "~1.168.40",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "UNLICENSED"
}
